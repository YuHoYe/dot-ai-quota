# Get this in Dot App → More → API Key. Never commit your real key.
DOT_API_KEY=
# Optional network proxy (Node 24.6+; npm scripts enable --use-env-proxy).
# HTTPS_PROXY=http://127.0.0.1:6152
# HTTP_PROXY=http://127.0.0.1:6152
# NO_PROXY=localhost,127.0.0.1,::1
# Optional provider locations:
# CLAUDE_BIN=/absolute/path/to/claude
# CLAUDE_CONFIG_DIR=/absolute/path/to/.claude
# CODEX_HOME=/absolute/path/to/.codex
